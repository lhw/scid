# =============================================================================
# Caddyfile — SCID reverse proxy  (local dev)
# =============================================================================
# Domains: id.scid.my  →  Pocket ID
#          scid.my     →  SCID companion + SvelteKit frontend
#
# TLS is handled with locally-trusted mkcert certificates (wildcard *.scid.my).
# Caddy's automatic HTTPS / ACME is disabled for these blocks; the cert files
# are mounted into the container at /certs/.
# =============================================================================

{
    # Disable the global ACME HTTP challenge listener — we're using static certs
    auto_https off
}

# Pocket ID — the main OIDC provider (login, passkeys, consent)
# We inject a <style> block into every HTML response to hide the first name,
# last name, and display name fields — Pocket ID has no native toggle for this.
id.scid.my {
    tls /certs/scid.my+1.pem /certs/scid.my+1-key.pem

    # Inject styles and a fixed "Return to SCID" back-button into every HTML page.
    # Fields hidden: first name, last name, display name (Pocket ID has no toggle for these).
    # Button: fixed top-LEFT so it does not overlap Pocket ID's dark-mode / profile icons.
    replace {
        match {
            header Content-Type text/html*
        }
        # Hide unwanted form fields.
        # The SCID back-button is injected via JS so it sits naturally inside
        # Pocket ID's own header nav — left of the dark-mode toggle — regardless
        # of how many icons Pocket ID adds in future updates.
        </head> "<style>div:has(>label[for=first-name]),div:has(>label[for=last-name]),div:has(>label[for=display-name]){display:none!important}#scid-back-btn{display:inline-flex;align-items:center;gap:.4rem;padding:.375rem .875rem;background:rgba(13,21,38,.92);border:1px solid rgba(0,212,255,.35);border-radius:.5rem;color:#00d4ff;font-family:inherit;font-size:.8125rem;font-weight:500;text-decoration:none;backdrop-filter:blur(8px);box-shadow:0 2px 12px rgba(0,0,0,.35);transition:background .15s,border-color .15s}#scid-back-btn:hover{background:rgba(0,212,255,.08);border-color:rgba(0,212,255,.65)}#scid-back-btn svg{width:1em;height:1em;flex-shrink:0;vertical-align:-.1em}</style></head>"
        # Build the button in JS and prepend it into Pocket ID's right-nav group.
        # Fallback: fixed-position if the header selector fails.
        </body> "<script>(function(){function mkBtn(){var a=document.createElement('a');a.id='scid-back-btn';a.href='https://scid.my';var ns='http://www.w3.org/2000/svg';var svg=document.createElementNS(ns,'svg');svg.setAttribute('viewBox','0 0 24 24');svg.setAttribute('fill','none');svg.setAttribute('stroke','currentColor');svg.setAttribute('stroke-width','2');svg.setAttribute('stroke-linecap','round');svg.setAttribute('stroke-linejoin','round');var l=document.createElementNS(ns,'line');l.setAttribute('x1','19');l.setAttribute('y1','12');l.setAttribute('x2','5');l.setAttribute('y2','12');var p=document.createElementNS(ns,'polyline');p.setAttribute('points','12 19 5 12 12 5');svg.appendChild(l);svg.appendChild(p);a.appendChild(svg);a.appendChild(document.createTextNode('\u00a0Return to SCID'));return a;}document.addEventListener('DOMContentLoaded',function(){var btn=mkBtn();var h=document.querySelector('header');if(h){var c=h.querySelector(':scope>div')||h;var r=c.lastElementChild;if(r&&r!==c.firstElementChild){r.insertBefore(btn,r.firstChild);return;}}btn.style.cssText='position:fixed;top:.875rem;right:16rem;z-index:9999';document.body.appendChild(btn);});})();</script></body>"
    }

    # Disable upstream compression so the replace module can read the body.
    reverse_proxy pocket-id:1411 {
        header_up Accept-Encoding identity
    }
}

# SCID — companion API + SvelteKit frontend
scid.my {
    tls /certs/scid.my+1.pem /certs/scid.my+1-key.pem

    # Companion REST API
    handle /api/* {
        reverse_proxy companion:8080
    }

    # SvelteKit frontend (dev server)
    handle {
        reverse_proxy frontend:5173
    }
}
