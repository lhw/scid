# Local development environment — not committed to version control.
# Copy this to .env and adjust values.

# Vite dev proxy target for /api/* requests
VITE_API_BASE=http://localhost:8080

# OIDC client config — must match what's registered in Pocket ID
PUBLIC_POCKET_ID_URL=https://id.scid.my
PUBLIC_OIDC_CLIENT_ID=scid-frontend

# Cloudflare Turnstile site key (public — baked into the browser bundle).
# Leave blank to disable the captcha widget in development.
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (private — used by the backend to verify captcha responses).
TURNSTILE_SECRET_KEY=