# =============================================================================
# Caddyfile — SCID reverse proxy  (local dev)
# =============================================================================
# Domains: id.scid.my  →  Pocket ID
#          scid.my     →  SCID companion + SvelteKit frontend
#
# TLS is handled with locally-trusted mkcert certificates (wildcard *.scid.my).
# Caddy's automatic HTTPS / ACME is disabled for these blocks; the cert files
# are mounted into the container at /certs/.
# =============================================================================

{
    # Disable the global ACME HTTP challenge listener — we're using static certs
    auto_https off
}

# Pocket ID — the main OIDC provider (login, passkeys, consent)
id.scid.my {
    tls /certs/scid.my+1.pem /certs/scid.my+1-key.pem
    reverse_proxy pocket-id:1411
}

# SCID — companion API + SvelteKit frontend
scid.my {
    tls /certs/scid.my+1.pem /certs/scid.my+1-key.pem

    # Companion REST API
    handle /api/* {
        reverse_proxy companion:8080
    }

    # SvelteKit frontend (dev server)
    handle {
        reverse_proxy frontend:5173
    }
}
